# Copy to .env. The CLI loads it automatically; .env is gitignored.
# On Vercel these same names go in Project Settings → Environment Variables.

# --- required ---------------------------------------------------------

# Does the reading. Free at https://build.nvidia.com
NVIDIA_API_KEY=

# Reaches your accounts. Free tier: 20,000 tool calls/month.
# https://app.composio.dev  — not needed if you only use RSS sources.
COMPOSIO_API_KEY=

# --- telegram delivery ------------------------------------------------

# From @BotFather: /newbot, then copy the token.
TELEGRAM_BOT_TOKEN=

# Message your bot once, then open
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# and copy result[0].message.chat.id
TELEGRAM_CHAT_ID=

# Any random string. Telegram echoes it on every webhook call, which is what
# stops anyone who finds your URL from posting fake feedback into your profile.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

# --- hosting (Vercel) -------------------------------------------------

# Serverless has no persistent disk, so the database lives in Turso.
# Free tier at https://turso.tech — 5GB, far more than this needs.
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# Vercel sends this as `Authorization: Bearer ...` on scheduled requests.
# Without it, anyone who finds the URL can trigger a run and spend your quota.
# CRON_SECRET=

# --- optional ---------------------------------------------------------

# Only if you set `models.provider: anthropic` in config.yaml.
# ANTHROPIC_API_KEY=

# DOOMSCROLLER_USER=default
