# Copy to .env. The CLI loads it automatically; .env is gitignored.

# Reads and writes your feeds. Free tier: 20,000 tool calls/month.
# https://app.composio.dev
COMPOSIO_API_KEY=

# Does the reading and writing of the brief.
# Free at https://build.nvidia.com — rate-limited rather than metered.
NVIDIA_API_KEY=

# Only needed if you set `models.provider: anthropic` in config.yaml.
# https://console.anthropic.com
# ANTHROPIC_API_KEY=

# Optional: overrides user_id from config.yaml
# DOOMSCROLLER_USER=default
